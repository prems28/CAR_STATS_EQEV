<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fillViewport="true"
    tools:context="com.premsethueqev.clusterio.DemoActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="32dp">

        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10dp"
            android:layout_marginEnd="@dimen/_30dp"
            android:text="@string/refresh"
            android:textColor="@color/black"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvEvBatteryLevel"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="@drawable/textview_border_bg"
        android:gravity="center"
        android:padding="30dp"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="10sp"
        android:autoSizeMaxTextSize="18sp"
        android:autoSizeStepGranularity="1sp"
        android:text="@string/ev_battery_level_label" />

    <TextView
        android:id="@+id/tvEvEstimatedRange"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="@drawable/textview_border_bg"
        android:gravity="center"
        android:padding="30dp"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="10sp"
        android:autoSizeMaxTextSize="18sp"
        android:autoSizeStepGranularity="1sp"
        android:text="@string/ev_estimated_range_label" />

    <TextView
        android:id="@+id/tvEvBatteryCapacity"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="@drawable/textview_border_bg"
        android:gravity="center"
        android:padding="30dp"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="10sp"
        android:autoSizeMaxTextSize="18sp"
        android:autoSizeStepGranularity="1sp"
        android:text="@string/ev_battery_capacity_label" />

    <TextView
        android:id="@+id/tvMilesSinceCharge"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="@drawable/textview_border_bg"
        android:gravity="center"
        android:padding="30dp"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="10sp"
        android:autoSizeMaxTextSize="18sp"
        android:autoSizeStepGranularity="1sp"
        android:text="@string/miles_since_charge_label" />

    <TextView
        android:id="@+id/tvEvChargeState"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="@drawable/textview_border_bg"
        android:gravity="center"
        android:padding="30dp"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="10sp"
        android:autoSizeMaxTextSize="18sp"
        android:autoSizeStepGranularity="1sp"
        android:text="@string/ev_charge_state_label" />

    <TextView
        android:id="@+id/tvEvChargePortOpen"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="@drawable/textview_border_bg"
        android:gravity="center"
        android:padding="30dp"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="10sp"
        android:autoSizeMaxTextSize="18sp"
        android:autoSizeStepGranularity="1sp"
        android:text="@string/ev_charge_port_open_label" />

    <TextView
        android:id="@+id/tvEvChargePortConnected"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="@drawable/textview_border_bg"
        android:gravity="center"
        android:padding="30dp"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="10sp"
        android:autoSizeMaxTextSize="18sp"
        android:autoSizeStepGranularity="1sp"
        android:text="@string/ev_charge_port_connected_label" />

    <TextView
        android:id="@+id/tvEvPortLocation"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="@drawable/textview_border_bg"
        android:gravity="center"
        android:padding="30dp"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="10sp"
        android:autoSizeMaxTextSize="18sp"
        android:autoSizeStepGranularity="1sp"
        android:text="@string/ev_port_location_label" />

        <!-- Lays the circles out in rows and wraps to the next row when the screen is full -->
        <androidx.constraintlayout.helper.widget.Flow
            android:id="@+id/dialFlow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10dp"
            android:layout_marginStart="@dimen/_30dp"
            android:layout_marginEnd="@dimen/_30dp"
            app:constraint_referenced_ids="tvEvBatteryLevel,tvEvEstimatedRange,tvEvBatteryCapacity,tvMilesSinceCharge,tvEvChargeState,tvEvChargePortOpen,tvEvChargePortConnected,tvEvPortLocation"
            app:flow_wrapMode="chain"
            app:flow_horizontalStyle="packed"
            app:flow_horizontalGap="24dp"
            app:flow_verticalGap="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnRefresh" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
